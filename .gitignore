# Data and artefacts are DVC-managed and live on DagsHub, never in git.
# Deny wholesale, then allow back only the pointers and documentation, so a new
# dataset dropped in is covered without anyone remembering to add it.
Datasets/*
!Datasets/*.dvc
!Datasets/README.md
/reports

# Never commit credentials. DVC writes its own .dvc/.gitignore for config.local;
# this is a second line of defence.
.dvc/config.local
*.env
*.pem

# Local environments, per project
venv/
.venv/

# Binaries: everything of size belongs to DVC
*.npz
*.pt
*.pth
*.ckpt

# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
