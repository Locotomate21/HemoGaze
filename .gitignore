# Patient data: deny everything under data/, then allow back only the docs.
# A whitelist rather than a list of known dataset folders, because the previous
# version enumerated data/cp-anemic/ and data/synthetic/ by name -- so a new
# dataset dropped into data/ was not covered until someone remembered to add it.
data/*
!data/README.md

# runs & artifacts
reports/
*.npz
*.pt
*.pth
*.ckpt

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
